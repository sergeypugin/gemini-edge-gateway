{
  "name": "gemini-edge-gateway",
  "main": "src/index.js",
  "compatibility_date": "2026-09-28",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./public"
  },
  "triggers": {
    "crons": [
      "0 0 * * *"
    ]
  },
  "placement": {
    "mode": "smart"
  }
}
